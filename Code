# =========================================================
# HAND LANDMARK FEATURES
# =========================================================

def get_features(hand_landmarks):
    points = []

    base = hand_landmarks.landmark[0]

    for p in hand_landmarks.landmark:
        points.append(p.x - base.x)
        points.append(p.y - base.y)
        points.append(p.z - base.z)

    return points


# =========================================================
# SIMPLE SIGN RECOGNITION
# =========================================================

def recognize_sign(hand):
    lm = hand.landmark

    # Finger tip and joint indexes
    fingers = [
        (8, 6),    # index
        (12, 10),  # middle
        (16, 14),  # ring
        (20, 18)   # pinky
    ]

    opened = 0

    for tip, joint in fingers:
        if lm[tip].y < lm[joint].y:
            opened += 1

    # Thumb
    thumb_open = abs(lm[4].x - lm[2].x) > 0.08

    # Basic gesture dictionary
    if opened == 0:
        return "A"

    if opened == 1:
        return "L"

    if opened == 2:
        return "V"

    if opened == 3:
        return "W"

    if opened == 4 and thumb_open:
        return "HELLO"

    return "UNKNOWN"


# =========================================================
# CAMERA
# =========================================================

cap = None
running = False

def start_camera():
    global cap, running

    if running:
        return

    cap = cv2.VideoCapture(0)

    if not cap.isOpened():
        messagebox.showerror("Camera Error", "Unable to open webcam.")
        return

    running = True
    status_label.config(
        text="● CAMERA CONNECTED",
        fg="#22c55e"
    )

    update_camera()


def stop_camera():
    global running, cap

    running = False

    if cap:
        cap.release()
        cap = None

    camera_label.config(image="")
    status_label.config(
        text="● CAMERA OFFLINE",
        fg="#ef4444"
    )


def update_camera():
    global last_sign, last_time

    if not running or cap is None:
        return

    success, frame = cap.read()

    if not success:
        root.after(10, update_camera)
        return

    frame = cv2.flip(frame, 1)

    rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    result = hands.process(rgb)

    detected = "UNKNOWN"
    confidence = 0

    if result.multi_hand_landmarks:

        for hand in result.multi_hand_landmarks:

            mp_draw.draw_landmarks(
                frame,
                hand,
                mp_hands.HAND_CONNECTIONS
            )

            detected = recognize_sign(hand)

            if detected != "UNKNOWN":
                confidence = 95
            else:
                confidence = 30

            # Prevent repeated predictions
            current = time.time()

            if (
                detected != "UNKNOWN"
                and detected != last_sign
                and current - last_time > 1
            ):
                add_sign(detected)
                last_sign = detected
                last_time = current

    prediction_label.config(
        text=detected,
        fg="#22c55e" if detected != "UNKNOWN" else "#f59e0b"
    )

    confidence_label.config(
        text=f"Confidence: {confidence}%"
    )

    # Camera image
    img = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)

    from PIL import Image, ImageTk

    img = Image.fromarray(img)
    img = img.resize((650, 480))

    photo = ImageTk.PhotoImage(img)

    camera_label.config(image=photo)
    camera_label.image = photo

    root.after(10, update_camera)


# =========================================================
# TEXT PROCESSING
# =========================================================

def add_sign(sign):

    global sentence

    if sign == "HELLO":
        sentence += "Hello "

    elif sign == "A":
        sentence += "A"

    elif sign == "L":
        sentence += "L"

    elif sign == "V":
        sentence += "V"

    elif sign == "W":
        sentence += "W"

    sentence_label.config(text=sentence)

    if sentence.strip():
        history.insert(
            0,
            (
                datetime.now().strftime("%H:%M:%S"),
                sign,
                sentence.strip()
            )
        )

        update_history()


def add_space():
    global sentence
    sentence += " "
    sentence_label.config(text=sentence)


def backspace():
    global sentence
    sentence = sentence[:-1]
    sentence_label.config(text=sentence)


def clear_text():
    global sentence
    sentence = ""
    sentence_label.config(text="")


# =========================================================
# SPEECH
# =========================================================

def speak():

    text = sentence.strip()

    if not text:
        messagebox.showinfo(
            "Speech",
            "There is no text to speak."
        )
        return

    engine.say(text)
    engine.runAndWait()


# =========================================================
# HISTORY
# =========================================================

def update_history():

    for item in history_tree.get_children():
        history_tree.delete(item)

    for row in history[:20]:
        history_tree.insert(
            "",
            "end",
            values=row
        )


def save_history():

    if not history:
        messagebox.showinfo(
            "History",
            "No recognition history available."
        )
        return

    path = filedialog.asksaveasfilename(
        defaultextension=".csv",
        filetypes=[("CSV File", "*.csv")]
    )

    if not path:
        return

    with open(
        path,
        "w",
        newline="",
        encoding="utf-8"
    ) as f:

        writer = csv.writer(f)

        writer.writerow([
            "Time",
            "Sign",
            "Sentence"
        ])

        writer.writerows(history)

    messagebox.showinfo(
        "Saved",
        "Recognition history saved successfully."
    )


